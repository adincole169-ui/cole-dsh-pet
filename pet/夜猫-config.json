{
  // ── 种类示例：夜猫模式 ──────────────────────────────────────────────────
  // 用法：  pythonw main.py --pet 夜猫
  //
  // 这是一个**完整的种类覆盖层**：文件里出现的顶层字段会整段替换主配置的同名字段
  // （与 dsh-pet 的合并口径一致——不做深合并），所以只写想改的部分即可。
  //
  // 真正换一个"角色"要做的是另一件事：把新角色的透明 webm 放进 `webm/`，然后在这里
  // 用同样的事件名（idle / clicks / drag / turn / moves / categories / events）指向
  // 它们。文件不需要和素材同名，配置里的名字才是引用键。

  "pets": [
    {
      "name": "大肥鱼·夜猫",
      // id 必须唯一：素材缓存、记忆、端点参数都按它走
      "id": "night",
      "size": 380,
      "display": "both",
      "balanceEnabled": true,
      "whisperEnabled": true,
      "workStatusEnabled": true,
      "position": {
        // 换到左下角，避免和主宠物重叠
        "corner": "bottom-left",
        "marginX": 40,
        "marginY": 40
      }
    }
  ],

  // 只调物理：更轻、更弹、地面更滑
  "physics": {
    "gravity": 1100,
    "restitution": 0.88,
    "groundFriction": 1.8,
    "ceilingBounce": true,
    "throwPower": 1.1,
    "petCollision": false
  },

  // 动画池：这里刻意收窄成"夜间向"的几段，用来演示种类可以有自己的动作集。
  // 若某个名字在 webm/ 里不存在，播放时会自动退回自由活动，不会崩。
  "animations": {
    "idle": ["待机呼吸休闲"],
    "turn": ["东张西望"],
    "drag": ["被鼠标拖拽悬空反馈"],
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-挠痒咯咯笑"
    ],
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } }
      ]
    },
    "categories": [
      {
        "id": "夜间小动作",
        "weight": 24,
        "actions": [
          "原地小憩沉眠",
          "深度睡眠",
          "打瞌睡被惊醒",
          "照镜子",
          "整体换装试色"
        ]
      },
      {
        "id": "夜宵",
        "weight": 16,
        "actions": ["吃白饭", "大口吃零食", "吃冰淇淋融化", "涮火锅"]
      }
    ],
    "events": {
      "workStatus": [
        "工作状态-思考冒泡",
        "工作状态-忙碌点按",
        "工作状态-清点归档",
        "工作状态-原地踱步张望",
        "工作状态-雀跃庆祝",
        "工作状态-垂头叹气冒汗"
      ],
      "whisper": ["碎碎念-发呆碎碎念"],
      "balance": ["余额-钱袋如常"]
    }
  },

  "animationWeights": { "idle": 10, "turn": 5, "move": 5 },

  // 换一套说话口气
  "whisperPrompt": "你是主人桌面上有点困的Q版蓝发小女仆。说话要很短（20字以内）、懒洋洋的、偶尔打个哈欠，不要说自己是AI。",

  "workStatusTexts": [
    ["（揉眼睛）正在想呢…", "让我理一下思路…"],
    ["正在做事哦，别催…", "这一步在处理啦"],
    ["收拾一下，接着看", "归档好了，继续"],
    ["要不要你看一眼？", "轮到你了哦…"],
    ["这轮做完啦，可以睡了吗", "搞定，摸鱼时间"],
    ["好像卡住了…", "这一步没过呢"]
  ]
}
