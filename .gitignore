# 大肥鱼桌宠 .gitignore
#
# 核心原则：**动画素材不进仓库**。原因有两条，任何一条都足够：
#   1. 版权：素材来自 gmskywalker/deepseek-fat-fish-codex-pet，该仓库未附开源许可证
#      （GitHub 上 license 为 null），只在 README 里声明了非商业个人使用，
#      **未授予再分发权**（见 ASSETS.md）；
#   2. 体积：解码后的帧有 2.56 GB / 25423 个文件，远超 GitHub 的限制与常识。
#
# 所以：仓库里只有**代码、配置、文档与工具**；素材由使用者自己准备。
#
# ⚠️ 写法注意：**.gitignore 不支持行尾注释**。下面这些
#      webm/    # 说明文字
#    这类写法会让整行被当成一个文件名模式（"webm/    # 说明文字"），永远匹配不上。
#    这个坑本项目踩过一次——25543 个素材文件被暂存，见 DEVNOTES 的发布章节。
#    所以注释一律单独成行。

# ---------------------------------------------------------------- 素材（不进仓库）

# 上游透明动画源
webm/

# 解码出的 PNG 帧
frames/

# 重新解码时的回退备份（frames_old_480 之类）
frames_old_*/

# 图标：由 make_icon.py 从 webm 裁出，属上游素材的派生物
assets/

# 表情包：由 make_memes.py 从 webm 裁出，属上游素材的派生物
memes/

# ---------------------------------------------------------------- 运行痕迹

logs/
*.log
*.bak
config.jsonc.bak-*
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------- 本地环境

.venv/
venv/
env/

# ---------------------------------------------------------------- 打包与分发产物

dsh-pet-share/
dsh-pet-update/
dist/
*.zip

# ---------------------------------------------------------------- 临时与探针产物

_probe_*/
_*_frames/
_opt.png
_icon-frame.png
_dsh*.png
*.tmp

# ---------------------------------------------------------------- 编辑器 / 系统

.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
