// ============================================================================
// 用户个人配置层（模板）
// ============================================================================
//
// 【这是什么】
//   你自己的配置改动写在这里，就**不会**跟 `git pull` 冲突。
//   仓库里的 `config.jsonc` 保持原样，更新时不必解冲突。
//
// 【怎么用】
//   1. 把本文件复制一份，改名为 **config.user.jsonc**（去掉 .example）
//      powershell:  Copy-Item config.user.example.jsonc config.user.jsonc
//   2. 在里面只写**你要改的那几项**，其余留空
//   3. 重启桌宠生效
//
//   `config.user.jsonc` 已被 `.gitignore` 排除，`git status` 里看不到它，
//   所以它永远是你自己的、不会被更新覆盖。
//
// 【合并规则：整段替换】
//   与 `config.jsonc` 一致：**顶层字段整段替换，不做深合并**。
//   也就是说你写了 `"physics": { "gravity": 0 }`，整个 physics 段就被它替换掉，
//   没写的字段会取 `config.py` 里的内置默认值（不是取 config.jsonc 里那份）。
//   要改某一项又不想丢别的，就把那一整段抄过来再改。
//
// 【层级优先级】（低 → 高）
//   config.jsonc  →  config.user.jsonc  →  pet/<种类>-config.json
//   →  （选了种类时）再叠一次 config.user.jsonc
//   最后一步是故意的：**"我个人改的"优先于"某个种类的预设"**。
//
// 【想知道有没有生效】
//   python main.py --status     会打印「用户配置层」那一行
//
// 【写错了会怎样】
//   JSON 语法错误会**直接报错并拒绝启动**（不会静默忽略）——
//   这是有意的：静默忽略会让人以为"我的配置没生效是程序的 bug"。
//
// ============================================================================

{
  // 下面每一条都是**示例**，全部注释掉了。需要哪条就把它的注释去掉。
  //
  // 注意：JSONC 允许注释，但不允许**尾随逗号**，去掉注释时留意逗号。

  // ---- 帧来源：stream（默认，磁盘零占用） 或 cache（预解码 PNG，约 2.6 GB）----
  // "frameSource": "stream",

  // ---- 把宠物调大 / 调小（逻辑像素；本机 dpr=2，所以 320 对应物理 640）----
  // 注意：素材是 640x360，size 超过 320 就是放大、会变糊。
  // "pets": [
  //   {
  //     "id": "main",
  //     "name": "蓝毛小女仆",
  //     "displayName": "大肥鱼",
  //     "size": 320,
  //     "display": "both"
  //   }
  // ],

  // ---- 物理：关掉重力让宠物待在放下它的地方（默认 0 = 关）----
  // "physics": {
  //   "gravity": 0,
  //   "restitution": 0.78,
  //   "groundFriction": 2.5,
  //   "ceilingBounce": true,
  //   "throwPower": 1.0,
  //   "petCollision": false
  // },

  // ---- 碎碎念：默认开启，每次生成都会调用当前对话的模型 ----
  // 本地 LLM 单并发时它会顶掉正在跑的任务的 KV cache，不需要就关掉。
  // "whisperEnabled": false,

  // ---- 工作状态联动：跟随 DSH 会话事件切动画 + 气泡 ----
  // "workStatusEnabled": true,

  // ---- 拖拽抛掷：锁定在当前屏幕（多屏用户）----
  // "confineToScreen": false,

  // ---- 移动动画：只有写在这里的动作会让宠物真的移动 ----
  // 想让某个动作"也位移、但慢一点"，就给它 speedScale（< 1 = 慢）。
  // 距离以基准宠物宽 462px 为准，运行时按 size/462 等比缩放。
  // "animations": {
  //   "moves": {
  //     "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
  //     "actions": [
  //       { "name": "螃蟹走路" },
  //       { "name": "悠闲哼歌", "params": { "minDist": 15, "maxDist": 45, "speedScale": 0.3 } }
  //     ]
  //   }
  // },

  // ---- 联动端口（DSH 插件往这里投状态；一般不用改）----
  // "bridge": { "port": 8899 }
}
